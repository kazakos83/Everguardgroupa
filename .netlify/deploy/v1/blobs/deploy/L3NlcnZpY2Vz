eight=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big shrink-0 mt-0.5\" aria-hidden=\"true\" style=\"color:#C9A84C\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span class=\"text-white/60 text-sm\" style=\"font-family:var(--font-dm-sans)\">Executive background investigations</span></li></ul></div><div><h3 class=\"text-white/40 text-xs font-semibold uppercase tracking-widest mb-4\">Deliverables</h3><ul class=\"space-y-2.5\"><li class=\"flex items-start gap-2.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text shrink-0 mt-0.5\" aria-hidden=\"true\" style=\"color:rgba(201,168,76,0.5)\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg><span class=\"text-white/55 text-sm\" style=\"font-family:var(--font-dm-sans)\">Due diligence investigation report</span></li><li class=\"flex items-start gap-2.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text shrink-0 mt-0.5\" aria-hidden=\"true\" style=\"color:rgba(201,168,76,0.5)\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg><span class=\"text-white/55 text-sm\" style=\"font-fami